# Copy to .env and fill in. .env is gitignored — never commit real values.

# "sim" or "live". Defaults to sim. Live additionally requires SAXO_ALLOW_LIVE=yes.
SAXO_ENV=sim

# Either credential works; OAuth wins when both are present.

# Fallback: 24-hour token from https://www.developer.saxo. Expires daily.
SAXO_TOKEN=

# Preferred: OAuth app from the developer portal. Run scripts/login.py once,
# and the server refreshes on its own from then on. Leave SAXO_APP_SECRET
# empty to use PKCE, which keeps no secret on disk at all.
SAXO_APP_KEY=
SAXO_APP_SECRET=
SAXO_REDIRECT_URI=http://localhost:8080/callback

# Safety rail: must be exactly "yes" before any live-environment call is allowed.
SAXO_ALLOW_LIVE=no

# Largest order the server will send, in instrument units (FX: currency units,
# stocks: shares). A backstop against a misplaced decimal point.
SAXO_MAX_ORDER_AMOUNT=100000
