# Copy to .env and fill in. .env is gitignored — never commit real values.

# "sim" or "live". Defaults to sim. Live additionally requires SAXO_ALLOW_LIVE=yes.
SAXO_ENV=sim

# 24-hour token from https://www.developer.saxo (SIM only, expires daily).
SAXO_TOKEN=

# OAuth app credentials (Step 3 — not needed while using the 24h token).
SAXO_APP_KEY=
SAXO_APP_SECRET=
SAXO_REDIRECT_URI=http://localhost:8080/callback

# Safety rail: must be exactly "yes" before any live-environment call is allowed.
SAXO_ALLOW_LIVE=no

# Largest order the server will send, in instrument units (FX: currency units,
# stocks: shares). A backstop against a misplaced decimal point.
SAXO_MAX_ORDER_AMOUNT=100000
